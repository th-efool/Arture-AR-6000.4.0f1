--- !u!114 &1500477631782305500
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7863459636288244251}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fc100347e3ca30a4da4b437404ac20e1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MachineProfile
  MachineID: 1
  Name: Water Pump Test
  MachineType: 0
  Components:
  - componentValue: 0
    GameObjectRef: {fileID: 3205488731526493675}
    ComponentDescription: Converts electrical energy into rotational mechanical power
      to drive the pump.
  - componentValue: 1
    GameObjectRef: {fileID: 377662488076383471}
    ComponentDescription: Houses the electrical terminals used to connect the motor
      power supply.
  - componentValue: 2
    GameObjectRef: {fileID: 7953680883566258933}
    ComponentDescription: Protects the motor cooling fan while allowing airflow.
  - componentValue: 3
    GameObjectRef: {fileID: 6475495281964268662}
    ComponentDescription: Transfers rotational torque from the motor to the pump
      shaft.
  - componentValue: 4
    GameObjectRef: {fileID: 4096472160425650110}
    ComponentDescription: Covers the rotating coupling to protect against accidental
      contact.
  - componentValue: 5
    GameObjectRef: {fileID: 480083356208715050}
    ComponentDescription: Encloses the impeller chamber and directs water toward
      the discharge.
  - componentValue: 6
    GameObjectRef: {fileID: 2081933727540829152}
    ComponentDescription: Rotates to transfer energy to the water, increasing its
      velocity and pressure.
  - componentValue: 7
    GameObjectRef: {fileID: 5969091028503921701}
    ComponentDescription: Transfers torque from the coupling to the impeller.
  - componentValue: 8
    GameObjectRef: {fileID: 4791030170608576197}
